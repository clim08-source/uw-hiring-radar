# Copy to .env — every value is optional. With no key the app uses its keyword classifier.

# Google Gemini (preferred when set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI (used when no Gemini key is set)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Instagram bio links (optional) -------------------------------------------------------
# Primary: Apify runs apify/instagram-profile-scraper over all club handles in one batch.
APIFY_API_TOKEN=
# Fallback when no Apify token is set: one Google search per handle via serper.dev.
SERPER_API_KEY=
# With neither, the app uses the website / Linktree listed on WUSA and Sedra.
